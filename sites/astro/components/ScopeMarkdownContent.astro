---
// Auth's synthetic preview walkthrough retains its readable, scrollable image size.
import MarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
---
<MarkdownContent><slot /></MarkdownContent>
<style is:global>
  .sl-markdown-content table img { width: 210px; max-width: none; height: auto; }
</style>
